{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortPackageJson": false,
  "sortImports": {
    "groups": [
      "builtin",
      { "newlinesBetween": false },
      "astro",
      { "newlinesBetween": false },
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "unknown"
    ],
    "customGroups": [
      {
        "groupName": "astro",
        "elementNamePattern": ["astro", "astro/**", "astro:*"]
      }
    ],
    "internalPattern": ["@/"],
    "ignoreCase": true,
    "newlinesBetween": true
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/site/src/styles/global.css",
    "functions": ["cn", "cva", "clsx"]
  },
  "astro": {},
  "ignorePatterns": [
    "node_modules",
    "**/dist",
    "bun.lock",
    "/coverage",
    "apps/*/coverage",
    "packages/*/coverage",
    ".claude/worktrees",
    "**/.astro",
    ".claude/skills",
    "**/*.html"
  ]
}

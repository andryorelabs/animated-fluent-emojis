{
  "name": "@animated-fluent-emojis/site",
  "private": true,
  "type": "module",
  "description": "The static website for animated-fluent-emojis: landing, docs and emoji gallery.",
  "license": "MIT",
  "author": "Andry Orellana <hello@andryore.dev>",
  "homepage": "https://animated-fluent-emojis.andryore.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andryorelabs/animated-fluent-emojis.git",
    "directory": "apps/site"
  },
  "bugs": {
    "url": "https://github.com/andryorelabs/animated-fluent-emojis/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "i18n:status": "bun src/docs/i18n-status.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:dist": "SITE_DIST_REQUIRED=1 vitest run src/seo/distribution-output.test.ts",
    "test:e2e": "playwright test",
    "test:visual": "bash scripts/visual.sh",
    "test:visual:update": "bash scripts/visual.sh update",
    "lighthouse": "bash scripts/lighthouse-budget.sh"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/starlight": "^0.42.8",
    "@base-ui/react": "^1.9.0",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/astro": "^1.66.0",
    "animated-fluent-emojis": "workspace:*",
    "astro": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expressive-code": "^0.44.3",
    "hast-util-to-html": "^9.0.6",
    "lucide-react": "^1.66.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "^0.12.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/hast": "3.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

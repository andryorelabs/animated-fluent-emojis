---
import { localeSegment, type Locale } from "../i18n/locales";
import { getUi } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";
import { Gallery } from "./gallery/Gallery";
import { GallerySkeleton } from "./gallery/GallerySkeleton";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { gallery } = getUi(locale);
---

<Layout
  locale={locale}
  title={gallery.title}
  description={gallery.description}
  path="/emojis/"
  trail={[{ name: gallery.title, path: "/emojis/" }]}
>
  <main id="main" class="site-container flex-1 py-8">
    <h1 class="mb-6 text-heading-sm leading-tight font-extrabold text-balance">{gallery.title}</h1>
    <Gallery
      client:only="react"
      locale={locale}
      searchIndexUrl={`/search-index/${localeSegment(locale)}.json`}
      strings={gallery}
    >
      <div slot="fallback">
        <GallerySkeleton label={gallery.loading} size={64} />
      </div>
    </Gallery>
  </main>
</Layout>

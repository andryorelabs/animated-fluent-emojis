{
  "$schema": "https://emet.andryore.dev/schema/emet.config.schema.json",
  "version": 1,
  "repo": {
    "trunk": "develop",
    "remote": "origin"
  },
  "ticket": {
    "idPattern": "^AO-\\d+$",
    "branchPrefix": "ao"
  },
  "worktree": {
    "bootstrap": ["bun install --frozen-lockfile --silent"]
  },
  "concurrency": {
    "waveSize": 4,
    "maxLiveWorkers": "auto",
    "runIdleThresholdMs": 5400000
  },
  "tracker": {
    "kind": "linear",
    "transitions": {
      "onStart": "worker",
      "onPrOpen": "automatic",
      "onPrMerge": "automatic"
    },
    "team": "AO"
  },
  "preflight": {
    "requiredFiles": [],
    "requiredCommands": []
  },
  "handoff": {
    "maxLines": 60,
    "maxChars": 8000,
    "autoChain": true,
    "afterSpec": [
      { "paths": ["apps/site/**", "docs/**"], "mode": "promote" },
      { "mode": "release" }
    ]
  },
  "usage": {
    "oversizedReadLines": 400,
    "stalledMinutes": 10
  },
  "commands": {
    "selfCheck": ["bun run check", "bun run test"]
  },
  "pr": {
    "autoMerge": true,
    "mergeMethod": "squash",
    "maxCiFixAttempts": 2
  },
  "models": {
    "worker": {
      "model": "sonnet",
      "effort": "medium"
    },
    "reviewer": {
      "medium": {
        "model": "opus",
        "effort": "medium"
      },
      "high": {
        "model": "opus",
        "effort": "medium"
      }
    },
    "triage": "haiku",
    "escalation": {
      "sonnet": "opus"
    }
  },
  "language": {
    "conversation": "es",
    "artifacts": "en"
  },
  "deploy": {
    "check": {
      "command": "curl -fsS https://animated-fluent-emojis.andryore.dev/",
      "retries": 20,
      "intervalSeconds": 15,
      "timeoutSeconds": 360,
      "paths": ["apps/site/**", "docs/**"]
    }
  },
  "verify": {
    "browser": {
      "startCommand": "bun run --cwd apps/site dev",
      "url": "http://localhost:4321",
      "paths": ["apps/site/**"]
    }
  },
  "landing": {
    "specMergeMethod": "squash"
  },
  "validate": {
    "coupledSurfaces": [
      {
        "source": "docs/{guide,how-to}/**/*.md",
        "dependents": "apps/site/src/content/translations/**"
      }
    ]
  },
  "specs": {
    "enabled": true
  },
  "review": {
    "highRiskPaths": ["dockerfile", ".github/rulesets/"]
  }
}

{
  "$schema": "/home/andryore/.claude/emet/schema/emet.config.schema.json",
  "version": 1,
  "repo": {
    "trunk": "main",
    "remote": "origin"
  },
  "ticket": {
    "idPattern": "^AO-\\d+$",
    "branchPrefix": "ao"
  },
  "worktree": {
    "bootstrap": ["bun install --frozen-lockfile --silent"]
  },
  "concurrency": {
    "waveSize": 4,
    "maxLiveWorkers": "auto",
    "runIdleThresholdMs": 5400000
  },
  "tracker": {
    "kind": "linear",
    "transitions": {
      "onStart": "worker",
      "onPrOpen": "automatic",
      "onPrMerge": "automatic"
    },
    "team": "AO"
  },
  "preflight": {
    "requiredFiles": [],
    "requiredCommands": []
  },
  "handoff": {
    "maxLines": 60,
    "maxChars": 8000,
    "autoChain": true
  },
  "usage": {
    "oversizedReadLines": 400,
    "stalledMinutes": 10
  },
  "commands": {
    "selfCheck": ["bun run check", "bun run test"]
  },
  "pr": {
    "autoMerge": true,
    "mergeMethod": "squash",
    "maxCiFixAttempts": 2
  },
  "models": {
    "worker": {
      "model": "sonnet",
      "effort": "medium"
    },
    "reviewer": {
      "medium": {
        "model": "fable",
        "effort": "medium"
      },
      "high": {
        "model": "fable",
        "effort": "medium"
      }
    },
    "triage": "haiku",
    "escalation": {
      "sonnet": "fable"
    }
  }
}

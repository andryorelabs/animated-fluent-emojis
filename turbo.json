{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": ["bun.lock", "bunfig.toml", "tsconfig.base.json"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!coverage/**",
        "!dist-assets/**",
        "!dist-files/**",
        "!.cache/**"
      ],
      "outputs": []
    },
    "check": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!coverage/**",
        "!dist-assets/**",
        "!dist-files/**",
        "!.cache/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!coverage/**",
        "!dist-assets/**",
        "!dist-files/**",
        "!.cache/**"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!coverage/**",
        "!dist-assets/**",
        "!dist-files/**",
        "!.cache/**"
      ],
      "outputs": ["coverage/**"]
    },
    "sync": {
      "dependsOn": ["transit"],
      "outputs": [".astro/**"]
    },
    "build": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!coverage/**",
        "!dist-assets/**",
        "!dist-files/**",
        "!.cache/**"
      ],
      "outputs": ["dist/**"]
    },
    "lint:package": {
      "dependsOn": ["transit", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!coverage/**",
        "!dist-assets/**",
        "!dist-files/**",
        "!.cache/**"
      ],
      "outputs": ["dist/**"]
    },
    "size": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "//#check:root": {
      "dependsOn": [
        "animated-fluent-emojis#build",
        "@animated-fluent-emojis/site#sync"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/coverage/**",
        "!apps/assets/dist-assets/**",
        "!apps/assets/dist-files/**",
        "!apps/assets/.cache/**"
      ],
      "outputs": []
    },
    "//#test:coverage:root": {
      "inputs": [
        "scripts/**",
        "eslint-rules/**",
        "oxlint-plugins/**",
        "eslint.config.mjs",
        "oxlint.config.ts",
        "lint-policy.mjs",
        "tools/**",
        "docs/**",
        "README.md",
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "packages/*/src/**",
        ".github/**",
        ".claude/settings.json",
        ".claude/skills/**",
        ".husky/**",
        ".gitignore",
        ".node-version",
        "skills-lock.json",
        "renovate.json5",
        "vitest.config.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "//#test:root": {
      "inputs": [
        "scripts/**",
        "eslint-rules/**",
        "oxlint-plugins/**",
        "eslint.config.mjs",
        "oxlint.config.ts",
        "lint-policy.mjs",
        "tools/**",
        "docs/**",
        "README.md",
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "packages/*/src/**",
        ".github/**",
        ".claude/settings.json",
        ".claude/skills/**",
        ".husky/**",
        ".gitignore",
        ".node-version",
        "skills-lock.json",
        "renovate.json5",
        "vitest.config.ts"
      ],
      "outputs": []
    }
  }
}
